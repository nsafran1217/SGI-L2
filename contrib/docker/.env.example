# Copy to .env next to docker-compose.yml.

# l2's options (default -discover; -noconn: an L2 with no bricks;
# -usbpath 'b1;p2': only the L1s behind bus 1, port 2)
#L2_OPTIONS=-discover

# the telnet port of the L2 console (23 is taken if the host runs telnetd)
#TELNET_PORT=23

# the web l2gui: on with COMPOSE_PROFILES=webgui, and where it listens
# (it has no authentication: 127.0.0.1:8080 behind a reverse proxy, README.md)
#COMPOSE_PROFILES=webgui
#WEBGUI_LISTEN=0.0.0.0:8080

# the image's tag (a release, as v1.0.0, or latest)
#SGI_L2_TAG=latest
