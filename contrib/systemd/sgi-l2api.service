# l2api, the HTTP API to an L2, and the web l2gui at its / (make
# install-service installs it with @BINDIR@ and @WWWDIR@ filled in). It listens on 127.0.0.1:8080 and has no
# authentication of its own: to reach it from other machines, put a reverse
# proxy with TLS and a password in front of it (README.md), or set
# L2API_OPTIONS=--listen 0.0.0.0:8080 in /etc/default/sgi-l2api on a
# network you trust.

[Unit]
Description=SGI L2 HTTP API (l2api)
After=sgi-l2.service network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
Environment=L2API_OPTIONS=
EnvironmentFile=-/etc/default/sgi-l2api
ExecStart=@BINDIR@/l2api --l2 localhost --www @WWWDIR@ $L2API_OPTIONS
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
