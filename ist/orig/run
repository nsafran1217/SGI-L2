#!/bin/sh
# Run one of SGI's original IST tools from ist/orig/build (make -C ist/orig).
#
#   ist/orig/run errdmp --l2 <host> ...
#   ist/orig/run perl -e '...'        the shipped perl 5.6.1
#
# /stand is mapped to ist/orig/build/stand, and sgidiag's home
# (/usr/people/sgidiag, where errdmp and friends write their logs) to
# $SGIDIAG_HOME, default ~/sgidiag.
here=$(cd "$(dirname "$0")" && pwd)
root=$here/build
[ -f "$root/stand/.done" ] || { echo "run: make -C $here first" >&2; exit 1; }
[ $# -ge 1 ] || { sed -n '2,9s/^# \{0,1\}//p' "$0" >&2; exit 2; }

SGIDIAG_HOME=${SGIDIAG_HOME:-$HOME/sgidiag}
mkdir -p "$SGIDIAG_HOME"
IST_PATH_MAP="/stand=$root/stand:/usr/people/sgidiag=$SGIDIAG_HOME"
# the scan_* scripts are ksh (#!/bin/ksh); without one there, use $KSH or
# one on PATH (Debian: apt install ksh)
if [ ! -x /bin/ksh ]; then
  KSH=${KSH:-$(command -v ksh93 || command -v ksh || command -v mksh)}
  [ -n "$KSH" ] && IST_PATH_MAP="$IST_PATH_MAP:/bin/ksh=$KSH:/usr/bin/ksh=$KSH"
fi
LD_PRELOAD="$root/\$LIB/stand_shim.so${LD_PRELOAD:+ $LD_PRELOAD}"
LD_LIBRARY_PATH="$root/stand/sysco/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# the sgidiag account's environment (sgidiag/.sgi_env)
PATH=$PATH:/stand/sysco/bin:/stand/sysco/usr/bin
SCAN_USER_DATA=/stand/sysco/usr/data
SCAN_USER_CONFIG=/stand/sysco/usr/cfg
SCAN_USER_BIN=/stand/sysco/usr/bin
SCAN_USER_DIAGS=/stand/sysco/usr/data/diags
SCAN_PATH_DATA=/stand/sysco/data/scan
SCAN_PATH_BIN=/stand/sysco/bin
SCAN_PATH_CONFIG=/stand/sysco/cfg
SCAN_PATH_CFG=/stand/sysco/cfg/scan
TCL_LIBRARY=$root/stand/sysco/lib/tcl8.2
export IST_PATH_MAP LD_PRELOAD LD_LIBRARY_PATH PATH TCL_LIBRARY
export SCAN_USER_DATA SCAN_USER_CONFIG SCAN_USER_BIN SCAN_USER_DIAGS
export SCAN_PATH_DATA SCAN_PATH_BIN SCAN_PATH_CONFIG SCAN_PATH_CFG

tool=$1
shift
case $tool in
perl) exec "$root/stand/sysco/tools/bin/perl5.6.1" "$@" ;;
*/*)  prog=$tool ;;
*)    prog=$root/stand/sysco/bin/$tool
      [ -e "$prog" ] || prog=$root/stand/sysco/tools/bin/$tool ;;
esac
[ -e "$prog" ] || { echo "run: no such tool: $tool" >&2; exit 2; }
# the kernel would look the "#!" interpreter up unmapped
read -r first < "$prog" || true
case $first in
'#!/stand/'*)
  set -- "$prog" "$@"
  interp=${first#\#!}
  exec $root$interp "$@" ;;
'#!/bin/ksh'*|'#!/usr/bin/ksh'*)
  [ -x /bin/ksh ] || exec "${KSH:?run: no ksh for $tool (apt install ksh, or KSH=<path>)}" "$prog" "$@" ;;
esac
exec "$prog" "$@"
